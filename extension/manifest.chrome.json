{
  "manifest_version": 3,
  "name": "BiliWebAndroidStream",
  "version": "0.3.0",
  "description": "Play Bilibili web videos through the Bilibili Android DASH pipeline.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background-chrome.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "src/content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-bridge.js"
      ],
      "matches": [
        "https://www.bilibili.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {}
}
